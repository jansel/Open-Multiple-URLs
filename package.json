{
  "name": "open-multiple-urls-tab",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "build": "npm run type-check && vite build",
    "build:chrome": "npm run build",
    "package:chrome": "npm run build:chrome && node scripts/package.mjs",
    "dev:chrome": "vite build --watch",
    "test": "npm run test:unit",
    "test:unit": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:all": "npm run type-check && npm run lint && npm run format:check && npm run test:unit && npm run build:chrome && npm run test:e2e",
    "screenshots": "npm run build:chrome && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
