{
  "name": "Open Multiple URLs Tab",
  "version": "__VERSION__",
  "manifest_version": 3,
  "description": "Open lists of URLs from a persistent browser tab. Automatically extract links when pasting a whole new list.",
  "homepage_url": "https://github.com/jansel/Open-Multiple-URLs",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": "icon19.png",
    "default_title": "Open Multiple URLs Tab"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {}
  },
  "permissions": ["storage", "tabGroups", "search"],
  "incognito": "split",
  "minimum_chrome_version": "111"
}
